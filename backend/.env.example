NODE_ENV=development
PORT=3000
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Backend-only email configuration.
RESEND_API_KEY=
# Without a verified domain, keep onboarding@resend.dev and send only to
# the email address associated with the Resend account.
RESEND_FROM=NexoPerfil <onboarding@resend.dev>

# Public frontend origin used to build invitation links.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Supabase Storage (bucket macrocase-audios) for macrocase question audio.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Azure Speech: generates the voice (MP3 + lip-sync visemes) of each macrocase
# question when the macrocase is saved. Optional: without it, the candidate's
# browser reads the questions. Key and region: Azure portal → Speech resource →
# Keys and Endpoint. Voice list: https://learn.microsoft.com/azure/ai-services/speech-service/language-support
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=es-GT-MartaNeural
