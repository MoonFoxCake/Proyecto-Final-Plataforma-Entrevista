# Overrides for `vite build` (production mode) only — merged on top of
# `.env`. The backend runs on Render (not the same origin as Firebase
# Hosting), so this needs the full Render service URL, e.g.:
#   VITE_API_BASE_URL=https://nexo-perfil-api.onrender.com/api/v1
# Replace with your actual Render service URL once it's created.
VITE_API_BASE_URL=https://nexo-perfil-api.onrender.com/api/v1
