# Overrides for `vite build` (production mode) only — merged on top of
# `.env`. In production, frontend and backend are served from the same
# Firebase Hosting domain, and firebase.json rewrites `/api/**` to the
# `api` Cloud Function, so this can just be a relative path (no CORS, no
# hardcoded Cloud Functions URL).
VITE_API_BASE_URL=/api/v1
